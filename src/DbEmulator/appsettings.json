{
  "Source": {
    // The live account is ONLY READ. Connect with a read-only key (entered once in the app, stored encrypted)
    // or with Entra ID: set "Authentication": "EntraId" and "AccountEndpoint" below.
    "Authentication": "Key",
    "AccountEndpoint": "",
    "TenantId": "",
    // Databases to copy (empty = all) and containers to skip ("database/container").
    "Databases": [],
    "ExcludeContainers": [],
    "PageSize": 1000
  },
  "Server": {
    // Same port as the official emulator, so existing emulator connection strings work.
    "Port": 8081,
    "UseHttps": true,
    "HttpPort": 0,
    // Let your app write to the local copy (writes never leave this machine).
    "AllowLocalWrites": true,
    "LogRequests": false,
    // Hide documents whose TTL has passed, like Azure. Off: fetched data never disappears locally.
    "EnforceTtl": false
  },
  "Storage": {
    "DataDirectory": "data",
    // Fetched snapshots (backups) to keep; 0 = keep all.
    "KeepSnapshots": 10,
    "CompressSnapshots": false
  },
  "Fetch": {
    // 0 = only fetch when you ask for it (Fetch a fresh copy).
    "OnStartupIfOlderThanHours": 0,
    "AutoFetchEveryHours": 0
  }
}
